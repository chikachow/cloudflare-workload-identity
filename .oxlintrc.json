{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["node_modules", "coverage", ".vitest", ".wrangler"],
  "overrides": [
    {
      "files": ["workers/**/*.ts"],
      "plugins": ["unicorn", "typescript", "oxc", "import"],
      "rules": { "import/no-nodejs-modules": "deny" }
    }
  ]
}
